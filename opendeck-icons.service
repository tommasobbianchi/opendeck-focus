[Unit]
Description=Give each new OpenDeck key the image that belongs on it
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Python buffers stdout when it is not a terminal, which hides the log until the service dies.
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/projects/vsd-n1/opendeck-focus/set-key-image.py --watch
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
